# Port Configuration
PORT=5000

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/touchlive?retryWrites=true&w=majority

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK Configuration (Choose Option A or Option B)
# Option A: JSON string representation of Service Account key file
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"touch-live-7a1f8",...}

# Option B: Individual environment variables
FIREBASE_PROJECT_ID=touch-live-7a1f8
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@touch-live-7a1f8.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Xirsys WebRTC STUN/TURN Credentials Configuration (Optional - falls back to public Google STUN)
XIRSYS_IDENT=your_xirsys_ident
XIRSYS_SECRET=your_xirsys_secret
XIRSYS_CHANNEL=MyFirstApp
